# Python
.venv/
__pycache__/
*.pyc

# The exported ExecuTorch program and the rows of its C array. create_ai_layer.py
# writes both into the generated AI layer; at ~2.8 MB (a ~14 MB C source) they
# are regenerated by "Create AI layer" rather than committed. The clayer, the
# headers and model_pte.c, which includes the rows, are committed.
*.pte
ai_layer/model_pte_data.inc

# The pico-faces checkpoints setup_venv.py downloads (see PICO_FACES_FILES).
model/pico_faces/

# CMSIS-Toolbox build outputs. RTE/ is tracked in full: the layers' configuration
# files and the per-context RTE/_<build>_<target>/ headers the toolbox writes.
out/
tmp/
.cmsis/
*.cbuild-idx.yml
*.cbuild-pack.yml
*.cbuild-mlops.yml
*.update@*
.cmd.jlink

# Compiler-generated dependencies
*.d
# CMSIS Solution drop-ins are source files, despite the directory suffix.
!.vscode.d/

# Object files
*.o
*.ko
*.obj

# Linker output
*.elf
*.ilk
*.map
*.exp

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Executables and images
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# Regenerated by the CMSIS Solution / clangd extensions on every build, with
# absolute paths for the machine that built it -- so it cannot be committed in
# a portable form. Not committing it loses nothing: it is generated for you.
.clangd

# FVP output captured by CI and by the manual run in the README
fvp_stdout.log

# Editor config. The CMSIS Solution extension regenerates tasks.json,
# settings.json, cmsis.json and launch.json; only the macOS FVP wiring is kept:
# the model shim + its Dockerfile, and launch.json.mac, an Arm-FVP launch
# config that waits for the model in Docker (see the comment in it). The
# leading negation overrides a global excludes file that ignores every .vscode
# directory.
!.vscode/
.vscode/*
!.vscode/fvp.sh
!.vscode/fvp.Dockerfile
!.vscode/launch.json.mac

# --- CorteX ARM (firmware/, host/, ml/, board_demo/) ---
build/
out/
tmp/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
.secrets*
.DS_Store
.claude/worktrees/

# Model bundle: fetched by tools/fetch_model.sh from the Reproduce_Baselines release.
# Committed: firmware/model/params.json (= preprocess_params.json), student.json, model.py,
# and the .pte as a C array in firmware/ai_layer/model_pte.c.
model/*.pte
model/*.npz
firmware/model/*.pte
firmware/model/*.npz
firmware/model/*.pt
firmware/model/preprocess_params.json
firmware/ai_layer/*.pte

# Replay streams from host/export_replay.py (BCI IV 2a data; datasets are never committed)
host/data/*.npz

# CMSIS-Toolbox / CMSIS Solution outputs. RTE/_<build>_<target>/ headers are tracked.
firmware/.cmsis/
firmware/*.cbuild-idx.yml
firmware/*.cbuild-pack.yml
firmware/*.cbuild-mlops.yml
firmware/.venv/
firmware/.cmd.jlink
*.update@*
.clangd
*.axf
*.elf
*.map
*.o
*.d
!firmware/.vscode.d/
*.bin
!firmware/.alif/M55_HP_mram_stub.bin

# Editor config: the CMSIS Solution extension regenerates these; only the macOS FVP wiring is kept.
.vscode/launch.json
firmware/.vscode/*
!firmware/.vscode/fvp.sh
!firmware/.vscode/fvp.Dockerfile
!firmware/.vscode/launch.json.mac

# ML training outputs (ml/*): runs, caches, exported bundles, generated reports
ml/*/runs/
ml/*/artifacts/
ml/*/results/
ml/*/mne_data/
