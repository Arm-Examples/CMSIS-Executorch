# Initial CMake cache for a separate upstream MLEK checkout, not the root CMSIS solution.
set(TARGET_PLATFORM alif CACHE STRING "")
set(TARGET_SUBSYSTEM RTSS-HP CACHE STRING "")
set(TARGET_BOARD AppKit-e8 CACHE STRING "")
set(ALIF_DEVICE_SKU AE822FA0E5597 CACHE STRING "")
set(CONSOLE_UART 4 CACHE STRING "")
set(ML_FRAMEWORK ExecuTorch CACHE STRING "")
set(USE_CASE_BUILD alif_img_class CACHE STRING "")
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(ALIF_CAMERA_ENABLED ON CACHE BOOL "")
set(ALIF_CAMERA_MODULE OV5675 CACHE STRING "")
set(ALIF_ISP_ENABLED ON CACHE BOOL "")
set(ETHOS_U_NPU_ENABLED ON CACHE BOOL "")
set(ETHOS_U_NPU_ID U85 CACHE STRING "")
set(ETHOS_U_NPU_CONFIG_ID Z256 CACHE STRING "")
set(ETHOS_U_NPU_MEMORY_MODE Shared_Sram CACHE STRING "")
set(OSPI_RAM_SUPPORT OFF CACHE BOOL "")
set(OSPI_FLASH_SUPPORT OFF CACHE BOOL "")
set(alif_img_class_ACTIVATION_BUF_SZ 0x00200000 CACHE STRING "")
set(alif_img_class_SKIP_MODEL OFF CACHE BOOL "")
set(alif_img_class_SHOW_PROFILING OFF CACHE BOOL "")
set(alif_img_class_SHOW_EXPOSURE OFF CACHE BOOL "")
set(alif_img_class_SHOW_INF_TIME OFF CACHE BOOL "")
# Supply alif_img_class_MODEL_PATH explicitly; never silently use a different model.
if(NOT DEFINED alif_img_class_MODEL_PATH OR NOT EXISTS "${alif_img_class_MODEL_PATH}")
    message(FATAL_ERROR "Supply -Dalif_img_class_MODEL_PATH=/absolute/path/to/verified-model.pte before -C")
endif()
file(SHA256 "${alif_img_class_MODEL_PATH}" _aoi_model_sha256)
if(NOT _aoi_model_sha256 STREQUAL "f468ea2feae405abd7cfb9c0e95a7e9a357fd42698646846dba5ec081411ec7a")
    message(FATAL_ERROR "Model differs from the recorded working AOI artifact; see model/manifest.json")
endif()
